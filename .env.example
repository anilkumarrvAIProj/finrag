# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-in-production-use-secrets-manager
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=finrag
POSTGRES_USER=finrag
POSTGRES_PASSWORD=finrag_dev_pw

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ─── Object Storage (MinIO / AWS S3) ─────────────────────────────────────────
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_RAW=finrag-raw
S3_BUCKET_PROCESSED=finrag-processed
S3_REGION=us-east-1

# ─── Weaviate ─────────────────────────────────────────────────────────────────
WEAVIATE_URL=http://weaviate:8080
WEAVIATE_API_KEY=


# ─── Model Provider Selection ─────────────────────────────────────────────────
# EMBEDDING_PROVIDER options: huggingface | local | ollama | openai | azure
# huggingface = free, runs in container, no setup needed (default)
# ollama      = free, runs in Ollama container, needs model pulled
# openai      = paid, requires OPENAI_API_KEY
# azure       = paid, requires Azure credentials
EMBEDDING_PROVIDER=huggingface

# LLM_PROVIDER options: ollama | openai | azure
# ollama = free, runs locally (default) — needs Ollama container + model
# openai = paid, requires OPENAI_API_KEY
# azure  = paid, requires Azure credentials
LLM_PROVIDER=ollama

# ─── Ollama (free local models) ───────────────────────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.2

# ─── HuggingFace local embeddings (free, no API key) ─────────────────────────
HF_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_DIMS=1536

# ─── Auth (Auth0 / Keycloak) ──────────────────────────────────────────────────
AUTH_DOMAIN=your-tenant.auth0.com
AUTH_AUDIENCE=https://finrag-api
AUTH_ALGORITHM=RS256

# ─── Ingestion ────────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=100
ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/msword,application/vnd.ms-excel,application/vnd.ms-powerpoint
OCR_CONFIDENCE_THRESHOLD=0.6
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=128

# ─── Retrieval ────────────────────────────────────────────────────────────────
TOP_K_RETRIEVE=20
TOP_K_RERANK=5
MIN_SIMILARITY_THRESHOLD=0.5

# ─── Internet Search ──────────────────────────────────────────────────────────
TAVILY_API_KEY=tvly-your-key-here

# ─── Monitoring ───────────────────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=INFO
